{
  "task_model": {
    "num_devices": 100,
    "tasks_per_device": 5,
    "task_size_range": [500, 5000]
  },
  "cpu_constraints": {
    "local_cpu_freq": 1.2,
    "edge_cpu_freq": 2.5,
    "cpu_scaling_factor": 0.001,
    "cpu_offload_overhead": 2
  },
  "memory_constraints": {
    "memory_local_scaling": 0.0005,
    "memory_edge_scaling": 0.0002,
    "memory_limit": 1024
  },
  "bandwidth_constraints": {
    "network_bandwidth": 100.0,
    "bandwidth_limit": 50.0
  }
}
